{
  "name": "sixth-sense-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm copy:maplibre-worker && next dev",
    "build": "pnpm copy:maplibre-worker && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "brand:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/generate-brand-assets.mjs",
    "map:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/sync-gta-map.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.107.1",
    "bs58": "^6.0.0",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "supercluster": "^9.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "@vercel/blob": "^2.9.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.3.0"
}
