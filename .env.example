# Copy to .env.local and fill in. Never commit real values.

# Base URL of the Sixth Sense backend API. Not available yet; see docs/phase-1-assessment.md.
NEXT_PUBLIC_API_BASE_URL=

# Public site URL, used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show clearly labelled sample data where the backend isn't available yet.
# Always on in `pnpm dev`; off in production builds unless set to "true".
# Never enable this for a public production deployment.
NEXT_PUBLIC_ENABLE_DEV_MOCKS=

# Development only (needs dev mocks). "true" signs you in as a clearly labelled
# sample viewer so you can try comments, votes and wallet linking against
# sample data. Unset = signed out, the same as production.
NEXT_PUBLIC_DEV_SAMPLE_VIEWER=

# Server-only. URL of the backend's OpenAPI 3 document (JSON). The Developer
# Portal's API reference is generated from it; unset shows "not published yet".
SIXTH_SENSE_OPENAPI_URL=
# (Legacy name SCENEID_OPENAPI_URL is still read as a fallback.)

# GTA VI map tiles (gtadb.org, CC BY 4.0), self-hosted. Unset = /tiles/gta6 from
# `pnpm map:sync` (development). Production: run `pnpm map:sync --upload` with
# BLOB_READ_WRITE_TOKEN set, then paste the printed URL here.
NEXT_PUBLIC_MAP_TILES_URL=
