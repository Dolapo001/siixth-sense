# Vercel environment variables for the Sixth Sense frontend.
# Paste into Project → Settings → Environment Variables → "Import .env", for
# Production (and Preview, pointed at a staging backend if you have one).
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# Required. The deployed backend API, over HTTPS, including /api/v1.
# Must be publicly reachable: Vercel can't reach 127.0.0.1 on your machine.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Recommended. Your public site URL (canonical URLs, Open Graph, sitemap).
# Unset falls back to Vercel's production URL (*.vercel.app).
NEXT_PUBLIC_SITE_URL=https://sixthsense.example.com

# Optional, server-only. The backend's OpenAPI document, for the Developer
# Portal's API reference. Unset shows "not published yet".
SIXTH_SENSE_OPENAPI_URL=https://api.example.com/api/v1/schema

# Leave these UNSET in Vercel:
#   NEXT_PUBLIC_ENABLE_DEV_MOCKS   sample data; never on a public deployment
#   NEXT_PUBLIC_DEV_SAMPLE_VIEWER  fake signed-in user; development only
#   NEXT_PUBLIC_MAP_TILES_URL      `pnpm build` generates and serves the map tiles itself
#   BLOB_READ_WRITE_TOKEN          not used by the app
#   ANTHROPIC_API_KEY              backend only; never give it to the frontend
